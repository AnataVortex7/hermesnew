#!/bin/bash
# hermes-sync backup | restore [--late] | status
# Backs up /home/hermes/.hermes to tgstorage (Telegram) and restores it after a Render restart.
[ -f /etc/hermes-backup.env ] && . /etc/hermes-backup.env
: "${BACKUP_URL:?BACKUP_URL not set}" "${BACKUP_TOKEN:?BACKUP_TOKEN not set}"

HOME_DIR=/home/hermes
NAME="${BACKUP_NAME:-hermes}"
URL="${BACKUP_URL%/}/hapi/backup/$NAME"
AUTH="Authorization: Bearer ${BACKUP_TOKEN}"
MARK=/tmp/.hermes_last_backup
DONE=/tmp/.hermes_restore_done
MAX_BYTES=$(( ${BACKUP_MAX_MB:-200} * 1024 * 1024 ))
# big, re-installable stuff is NOT backed up (only config, keys, memory, sessions, ...)
EXCL=(--exclude=.hermes/hermes-agent --exclude=.hermes/tools
      --exclude='*/node_modules' --exclude='*/__pycache__' --exclude='*/.cache' --exclude='*.pyc')
for x in ${BACKUP_EXCLUDE:-}; do EXCL+=("--exclude=$x"); done

changed() {  # any file (outside the excluded dirs) newer than the last backup?
  [ -d "$HOME_DIR/.hermes" ] || return 1
  [ -f "$MARK" ] || return 0
  find "$HOME_DIR/.hermes" \( -path "$HOME_DIR/.hermes/hermes-agent" -o -path "$HOME_DIR/.hermes/tools" \
       -o -name node_modules -o -name __pycache__ -o -name .cache \) -prune \
       -o -type f -newer "$MARK" -print -quit | grep -q .
}

case "${1:-}" in
backup)
  [ "${2:-}" = "--if-changed" ] && ! changed && exit 0
  [ -d "$HOME_DIR/.hermes" ] || { echo "[sync] no ~/.hermes yet, nothing to back up"; exit 0; }
  tmp=$(mktemp /tmp/hb.XXXXXX); trap 'rm -f "$tmp"' EXIT
  touch "$MARK.new"
  tar czf "$tmp" -C "$HOME_DIR" "${EXCL[@]}" .hermes 2>/dev/null
  size=$(stat -c %s "$tmp")
  [ "$size" -gt "$MAX_BYTES" ] && { echo "[sync] backup is $size bytes > limit, skipped (use BACKUP_EXCLUDE)"; exit 1; }
  if curl -fsS --retry 4 --retry-delay 10 --retry-all-errors --max-time 900 -X POST \
       -H "$AUTH" -H "Content-Type: application/gzip" -T "$tmp" "$URL" >/tmp/.hermes_sync_resp; then
    mv -f "$MARK.new" "$MARK"; echo "[sync] backup ok ($size bytes)"
  else
    echo "[sync] backup FAILED: $(cat /tmp/.hermes_sync_resp 2>/dev/null)"; exit 1
  fi ;;

restore)
  late=0; [ "${2:-}" = "--late" ] && late=1
  tries="${RESTORE_TRIES:-8}"; tmp=$(mktemp /tmp/hr.XXXXXX); trap 'rm -f "$tmp"' EXIT
  for i in $(seq 1 "$tries"); do
    code=$(curl -sS -o "$tmp" -w '%{http_code}' --max-time 300 -H "$AUTH" "$URL" 2>/dev/null)
    case "$code" in
      200)
        # safety: only ever extract paths under .hermes/
        if ! tar tzf "$tmp" >/dev/null 2>&1 || tar tzf "$tmp" | grep -qvE '^\.hermes(/|$)'; then
          echo "[sync] backup file looks wrong, NOT restored"; exit 1; fi
        opts=(--no-same-owner); [ "$late" = 1 ] && opts+=(--skip-old-files)   # late restore never overwrites newer local files
        tar xzf "$tmp" -C "$HOME_DIR" "${opts[@]}" && chown -R hermes:hermes "$HOME_DIR/.hermes"
        touch "$MARK" "$DONE"; echo "[sync] restored from backup"; exit 0 ;;
      404) touch "$MARK" "$DONE"; echo "[sync] no backup yet (first run)"; exit 0 ;;
      401) echo "[sync] wrong BACKUP_TOKEN"; exit 2 ;;
      *)   echo "[sync] storage not ready (http $code), retry $i/$tries"; sleep 15 ;;
    esac
  done
  echo "[sync] could not restore yet — backups stay paused until it works"; exit 1 ;;

status)
  curl -sS --max-time 60 -H "$AUTH" "${BACKUP_URL%/}/hapi/backups"; echo ;;
*) echo "usage: hermes-sync backup [--if-changed] | restore [--late] | status"; exit 64 ;;
esac
